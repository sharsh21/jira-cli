{
  "name": "jira-cli",
  "version": "0.1.0",
  "description": "Create and update Jira Cloud issues and log work from the terminal — with a Claude Code skill that logs your coding sessions to Jira.",
  "license": "MIT",
  "author": "Harsh Shah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharsh21/jira-cli.git"
  },
  "homepage": "https://github.com/sharsh21/jira-cli#readme",
  "bugs": {
    "url": "https://github.com/sharsh21/jira-cli/issues"
  },
  "keywords": [
    "jira",
    "jira-cloud",
    "cli",
    "worklog",
    "claude-code",
    "claude-skill"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "jira-cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p .",
    "dev": "tsc -p . --watch",
    "test": "npm run build && node --test dist/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "axios": "^1.7.7",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "3.9.9",
    "typescript": "^5.5.4"
  }
}
